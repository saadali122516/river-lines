<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/shape_dialog_bg"
    android:padding="@dimen/dialog_pad">

    <ImageView
        android:id="@+id/eco_badge"
        android:layout_width="@dimen/sprite_md"
        android:layout_height="@dimen/sprite_md"
        android:layout_alignParentStart="true"
        android:contentDescription="@string/cd_eco_badge"
        android:scaleType="fitCenter"
        android:src="@drawable/sprite_badge_eco" />

    <TextView
        android:id="@+id/eco_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignBottom="@id/eco_badge"
        android:layout_alignTop="@id/eco_badge"
        android:layout_marginStart="@dimen/gap_md"
        android:layout_toEndOf="@id/eco_badge"
        android:gravity="center_vertical"
        android:text="@string/eco_title"
        android:textAppearance="@style/TextAppearance.App.Headline"
        android:textSize="20sp" />

    <View
        android:id="@+id/eco_divider"
        android:layout_width="@dimen/divider_width"
        android:layout_height="@dimen/divider_height"
        android:layout_below="@id/eco_badge"
        android:layout_marginTop="@dimen/gap_md"
        android:background="@drawable/shape_divider_accent"
        android:importantForAccessibility="no" />

    <FrameLayout
        android:id="@+id/eco_body"
        android:layout_width="match_parent"
        android:layout_height="@dimen/eco_list_height"
        android:layout_below="@id/eco_divider"
        android:layout_marginTop="@dimen/gap_lg">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/eco_list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:scrollbars="none" />

        <TextView
            android:id="@+id/eco_empty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:text="@string/eco_empty"
            android:textAppearance="@style/TextAppearance.App.Body"
            android:visibility="gone" />

    </FrameLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/eco_close"
        style="@style/Widget.App.Button.Secondary"
        android:layout_width="match_parent"
        android:layout_height="@dimen/btn_secondary_height"
        android:layout_below="@id/eco_body"
        android:layout_marginTop="@dimen/gap_lg"
        android:text="@string/btn_close" />

</RelativeLayout>
