<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/shape_dialog_bg"
    android:padding="@dimen/dialog_pad">

    <ImageView
        android:id="@+id/tutorial_leaf"
        android:layout_width="@dimen/sprite_md"
        android:layout_height="@dimen/sprite_md"
        android:layout_alignParentStart="true"
        android:contentDescription="@string/cd_leaf"
        android:scaleType="fitCenter"
        android:src="@drawable/sprite_leaf" />

    <TextView
        android:id="@+id/tutorial_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignBottom="@id/tutorial_leaf"
        android:layout_alignTop="@id/tutorial_leaf"
        android:layout_marginStart="@dimen/gap_md"
        android:layout_toEndOf="@id/tutorial_leaf"
        android:gravity="center_vertical"
        android:text="@string/tutorial_title"
        android:textAppearance="@style/TextAppearance.App.Headline"
        android:textSize="20sp" />

    <View
        android:id="@+id/tutorial_divider"
        android:layout_width="@dimen/divider_width"
        android:layout_height="@dimen/divider_height"
        android:layout_below="@id/tutorial_leaf"
        android:layout_marginTop="@dimen/gap_md"
        android:background="@drawable/shape_divider_accent"
        android:importantForAccessibility="no" />

    <LinearLayout
        android:id="@+id/tutorial_step_one"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/tutorial_divider"
        android:layout_marginTop="@dimen/gap_lg"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="@dimen/icon_lg"
            android:layout_height="@dimen/icon_lg"
            android:background="@drawable/shape_icon_bubble"
            android:importantForAccessibility="no"
            android:padding="4dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_pipe_elbow" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/gap_md"
            android:layout_weight="1"
            android:text="@string/tutorial_step_one"
            android:textAppearance="@style/TextAppearance.App.Body"
            android:textSize="13sp" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/tutorial_step_two"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/tutorial_step_one"
        android:layout_marginTop="@dimen/gap_md"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="@dimen/icon_lg"
            android:layout_height="@dimen/icon_lg"
            android:background="@drawable/shape_icon_bubble"
            android:importantForAccessibility="no"
            android:padding="4dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_wave" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/gap_md"
            android:layout_weight="1"
            android:text="@string/tutorial_step_two"
            android:textAppearance="@style/TextAppearance.App.Body"
            android:textSize="13sp" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/tutorial_step_three"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/tutorial_step_two"
        android:layout_marginTop="@dimen/gap_md"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="@dimen/icon_lg"
            android:layout_height="@dimen/icon_lg"
            android:background="@drawable/shape_icon_bubble"
            android:importantForAccessibility="no"
            android:padding="4dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_leaf_badge" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/gap_md"
            android:layout_weight="1"
            android:text="@string/tutorial_step_three"
            android:textAppearance="@style/TextAppearance.App.Body"
            android:textSize="13sp" />

    </LinearLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/tutorial_confirm"
        style="@style/Widget.App.Button.Primary"
        android:layout_width="match_parent"
        android:layout_height="@dimen/btn_secondary_height"
        android:layout_below="@id/tutorial_step_three"
        android:layout_marginTop="@dimen/gap_xl"
        android:minHeight="@dimen/btn_secondary_height"
        android:text="@string/btn_got_it" />

</RelativeLayout>
