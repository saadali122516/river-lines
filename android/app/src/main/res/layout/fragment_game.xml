<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_bg">

    <ImageView
        android:id="@+id/game_background"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop"
        android:src="@drawable/bg_game"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <View
        android:id="@+id/game_wash"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@drawable/overlay_game_wash"
        android:importantForAccessibility="no"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/game_header"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@drawable/shape_header_bar"
        android:minHeight="@dimen/header_height"
        android:paddingStart="@dimen/gap_md"
        android:paddingTop="@dimen/status_bar_pad"
        android:paddingEnd="@dimen/gap_md"
        android:paddingBottom="@dimen/gap_sm"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/game_back_button"
            style="@style/Widget.App.Button.Icon"
            android:layout_width="@dimen/touch_min"
            android:layout_height="@dimen/touch_min"
            android:contentDescription="@string/cd_back"
            app:icon="@drawable/ic_back"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/game_level_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:letterSpacing="0.06"
            android:maxLines="1"
            android:textColor="@color/color_text_primary"
            android:textSize="16sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toStartOf="@id/game_score"
            app:layout_constraintStart_toEndOf="@id/game_back_button"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/game_turns_left"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:accessibilityLiveRegion="polite"
            android:gravity="center"
            android:letterSpacing="0.1"
            android:maxLines="1"
            android:textColor="@color/color_accent"
            android:textSize="12sp"
            app:layout_constraintEnd_toEndOf="@id/game_level_name"
            app:layout_constraintStart_toStartOf="@id/game_level_name"
            app:layout_constraintTop_toBottomOf="@id/game_level_name" />

        <TextView
            android:id="@+id/game_score"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:accessibilityLiveRegion="polite"
            android:fontFeatureSettings="tnum"
            android:maxLines="1"
            android:minWidth="44dp"
            android:gravity="end"
            android:textColor="@color/color_primary"
            android:textSize="18sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <FrameLayout
        android:id="@+id/game_board_area"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="@dimen/screen_pad"
        android:layout_marginTop="@dimen/gap_md"
        android:layout_marginEnd="@dimen/screen_pad"
        android:layout_marginBottom="@dimen/gap_md"
        app:layout_constraintBottom_toTopOf="@id/game_controls"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/game_header">

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/game_board_card"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            app:cardBackgroundColor="@color/color_surface"
            app:cardCornerRadius="@dimen/card_radius"
            app:cardElevation="2dp"
            app:contentPadding="@dimen/board_frame"
            app:strokeColor="@color/color_stroke_soft"
            app:strokeWidth="@dimen/board_border">

            <com.riverlines.game.core.ui.RiverBoardView
                android:id="@+id/game_board"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/game_error_card"
            style="@style/Widget.App.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="@dimen/gap_xl">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="@string/error_level"
                    android:textAppearance="@style/TextAppearance.App.Title" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/game_error_retry"
                    style="@style/Widget.App.Button.Secondary"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/btn_secondary_height"
                    android:layout_marginTop="@dimen/gap_lg"
                    android:text="@string/btn_try_again" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

    </FrameLayout>

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/game_controls"
        android:layout_width="0dp"
        android:layout_height="@dimen/controls_height"
        android:layout_marginStart="@dimen/screen_pad"
        android:layout_marginEnd="@dimen/screen_pad"
        android:layout_marginBottom="@dimen/controls_margin_bottom"
        app:cardBackgroundColor="#F2FFFFFF"
        app:cardCornerRadius="@dimen/card_radius_lg"
        app:cardElevation="6dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:strokeColor="@color/color_stroke_soft"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="@dimen/gap_md">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/game_undo_button"
                style="@style/Widget.App.Button.Icon"
                android:layout_width="@dimen/btn_icon_size"
                android:layout_height="@dimen/btn_icon_size"
                android:contentDescription="@string/cd_undo"
                app:icon="@drawable/ic_undo" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/game_check_button"
                style="@style/Widget.App.Button.Primary"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_marginStart="@dimen/gap_md"
                android:layout_marginEnd="@dimen/gap_md"
                android:layout_weight="1"
                android:minHeight="52dp"
                android:text="@string/btn_check_flow" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/game_hint_button"
                style="@style/Widget.App.Button.Icon"
                android:layout_width="@dimen/btn_icon_size"
                android:layout_height="@dimen/btn_icon_size"
                android:contentDescription="@string/cd_hint"
                app:icon="@drawable/ic_hint" />

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

</androidx.constraintlayout.widget.ConstraintLayout>
