<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_bg_deep">

    <ImageView
        android:id="@+id/result_background"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop"
        android:src="@drawable/bg_result"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <View
        android:id="@+id/result_wash"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@drawable/overlay_result_wash"
        android:importantForAccessibility="no"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/result_content"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:paddingStart="@dimen/screen_pad"
        android:paddingTop="@dimen/status_bar_pad"
        android:paddingEnd="@dimen/screen_pad"
        android:paddingBottom="@dimen/nav_bar_pad"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/result_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/gap_md"
            android:accessibilityLiveRegion="polite"
            android:gravity="center"
            android:maxLines="1"
            android:text="@string/result_win"
            android:textAppearance="@style/TextAppearance.App.Headline.Result"
            android:textColor="@color/color_primary"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <View
            android:id="@+id/result_divider"
            android:layout_width="@dimen/divider_width_lg"
            android:layout_height="@dimen/divider_height"
            android:layout_marginTop="10dp"
            android:background="@drawable/shape_divider_accent"
            android:importantForAccessibility="no"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/result_title" />

        <androidx.core.widget.NestedScrollView
            android:id="@+id/result_scroll"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginTop="@dimen/gap_lg"
            android:layout_marginBottom="@dimen/gap_lg"
            android:fillViewport="true"
            app:layout_constraintBottom_toTopOf="@id/result_hint"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/result_divider">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/result_hero"
                    android:layout_width="@dimen/sprite_hero"
                    android:layout_height="@dimen/sprite_hero"
                    android:contentDescription="@string/cd_result_hero"
                    android:scaleType="fitCenter"
                    android:src="@drawable/sprite_lake" />

                <LinearLayout
                    android:id="@+id/result_stats_row"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/stat_card_height"
                    android:layout_marginTop="@dimen/gap_lg"
                    android:baselineAligned="false"
                    android:orientation="horizontal">

                    <com.riverlines.game.core.ui.StatCardView
                        android:id="@+id/result_stat_flow"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1" />

                    <com.riverlines.game.core.ui.StatCardView
                        android:id="@+id/result_stat_turns"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginStart="@dimen/gap_sm"
                        android:layout_weight="1" />

                    <com.riverlines.game.core.ui.StatCardView
                        android:id="@+id/result_stat_drops"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginStart="@dimen/gap_sm"
                        android:layout_weight="1" />

                </LinearLayout>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/result_note_card"
                    style="@style/Widget.App.Card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/gap_lg"
                    app:cardCornerRadius="@dimen/card_radius_sm">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="@dimen/gap_md">

                        <ImageView
                            android:layout_width="@dimen/sprite_sm"
                            android:layout_height="@dimen/sprite_sm"
                            android:contentDescription="@string/cd_leaf"
                            android:scaleType="fitCenter"
                            android:src="@drawable/sprite_leaf" />

                        <TextView
                            android:id="@+id/result_note_text"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/gap_md"
                            android:layout_weight="1"
                            android:textAppearance="@style/TextAppearance.App.Body"
                            android:textSize="13sp" />

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>

        </androidx.core.widget.NestedScrollView>

        <TextView
            android:id="@+id/result_hint"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/gap_sm"
            android:gravity="center"
            android:text="@string/result_hint"
            android:textAppearance="@style/TextAppearance.App.Body"
            android:textSize="12sp"
            app:layout_constraintBottom_toTopOf="@id/result_play_again"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/result_play_again"
            style="@style/Widget.App.Button.Primary"
            android:layout_width="0dp"
            android:layout_height="@dimen/btn_primary_height"
            android:layout_marginBottom="@dimen/gap_md"
            android:text="@string/btn_play_again"
            app:icon="@drawable/ic_play"
            app:layout_constraintBottom_toTopOf="@id/result_menu"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/result_menu"
            style="@style/Widget.App.Button.Secondary"
            android:layout_width="0dp"
            android:layout_height="@dimen/btn_secondary_height"
            android:text="@string/btn_menu"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
