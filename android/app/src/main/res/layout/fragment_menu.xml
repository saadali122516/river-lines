<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_bg">

    <ImageView
        android:id="@+id/menu_background"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop"
        android:src="@drawable/bg_menu"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <View
        android:id="@+id/menu_wash"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@drawable/overlay_menu_wash"
        android:importantForAccessibility="no"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/menu_content"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:paddingStart="@dimen/screen_pad"
        android:paddingTop="@dimen/status_bar_pad"
        android:paddingEnd="@dimen/screen_pad"
        android:paddingBottom="@dimen/nav_bar_pad"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/menu_leaf"
            android:layout_width="@dimen/sprite_md"
            android:layout_height="@dimen/sprite_md"
            android:contentDescription="@string/cd_leaf"
            android:scaleType="fitCenter"
            android:src="@drawable/sprite_leaf"
            app:layout_constraintBottom_toBottomOf="@id/menu_title"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@id/menu_title" />

        <TextView
            android:id="@+id/menu_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/gap_sm"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/title_app"
            android:textAppearance="@style/TextAppearance.App.Headline"
            app:layout_constraintEnd_toStartOf="@id/menu_balance_pill"
            app:layout_constraintStart_toEndOf="@id/menu_leaf"
            app:layout_constraintTop_toTopOf="parent" />

        <LinearLayout
            android:id="@+id/menu_balance_pill"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:background="@drawable/shape_pill_balance"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="@dimen/gap_md"
            android:paddingEnd="@dimen/gap_md"
            app:layout_constraintBottom_toBottomOf="@id/menu_title"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/menu_title">

            <ImageView
                android:layout_width="@dimen/icon_sm"
                android:layout_height="@dimen/icon_sm"
                android:contentDescription="@string/cd_drops"
                android:scaleType="fitCenter"
                android:src="@drawable/sprite_droplet" />

            <TextView
                android:id="@+id/menu_balance_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:accessibilityLiveRegion="polite"
                android:fontFeatureSettings="tnum"
                android:maxLines="1"
                android:textColor="@color/color_primary"
                android:textSize="14sp"
                android:textStyle="bold" />

        </LinearLayout>

        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/menu_guideline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintGuide_percent="0.62" />

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/menu_play_tile"
            style="@style/Widget.App.Card.Tile"
            android:layout_width="0dp"
            android:layout_height="@dimen/menu_play_tile_height"
            android:layout_marginTop="@dimen/gap_lg"
            android:layout_marginEnd="6dp"
            app:layout_constraintEnd_toStartOf="@id/menu_guideline"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/menu_title">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="@dimen/gap_md">

                <ImageView
                    android:id="@+id/menu_spring"
                    android:layout_width="@dimen/sprite_xl"
                    android:layout_height="0dp"
                    android:contentDescription="@string/cd_spring"
                    android:scaleType="fitCenter"
                    android:src="@drawable/sprite_spring"
                    app:layout_constraintBottom_toTopOf="@id/menu_play_caption"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/menu_play_caption"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/gap_sm"
                    android:gravity="center"
                    android:maxLines="1"
                    android:text="@string/menu_play_caption"
                    android:textAppearance="@style/TextAppearance.App.Body"
                    android:textSize="12sp"
                    app:layout_constraintBottom_toTopOf="@id/menu_play_button"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/menu_play_button"
                    style="@style/Widget.App.Button.Primary"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/btn_primary_height"
                    android:text="@string/btn_play"
                    app:icon="@drawable/ic_play"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent" />

            </androidx.constraintlayout.widget.ConstraintLayout>

        </com.google.android.material.card.MaterialCardView>

        <com.riverlines.game.core.ui.StatCardView
            android:id="@+id/menu_stat_flow"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginStart="6dp"
            app:layout_constraintBottom_toTopOf="@id/menu_stat_rivers"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="@id/menu_guideline"
            app:layout_constraintTop_toTopOf="@id/menu_play_tile"
            app:layout_constraintVertical_chainStyle="spread" />

        <com.riverlines.game.core.ui.StatCardView
            android:id="@+id/menu_stat_rivers"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginStart="6dp"
            android:layout_marginTop="@dimen/gap_md"
            app:layout_constraintBottom_toBottomOf="@id/menu_play_tile"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="@id/menu_guideline"
            app:layout_constraintTop_toBottomOf="@id/menu_stat_flow" />

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/menu_eco_tile"
            style="@style/Widget.App.Card"
            android:layout_width="0dp"
            android:layout_height="@dimen/menu_eco_tile_height"
            android:layout_marginTop="@dimen/gap_md"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/menu_play_tile">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="@dimen/gap_md"
                android:paddingEnd="@dimen/gap_md">

                <ImageView
                    android:layout_width="@dimen/sprite_lg"
                    android:layout_height="@dimen/sprite_lg"
                    android:contentDescription="@string/cd_eco_badge"
                    android:scaleType="fitCenter"
                    android:src="@drawable/sprite_badge_eco" />

                <com.riverlines.game.core.ui.SectionHeaderView
                    android:id="@+id/menu_eco_header"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/gap_md"
                    android:layout_marginEnd="@dimen/gap_sm"
                    android:layout_weight="1" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/menu_eco_button"
                    style="@style/Widget.App.Button.Secondary"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/btn_secondary_height"
                    android:text="@string/btn_open" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <ImageView
            android:id="@+id/menu_heron"
            android:layout_width="@dimen/sprite_decor"
            android:layout_height="0dp"
            android:layout_marginTop="@dimen/gap_sm"
            android:layout_marginBottom="@dimen/gap_sm"
            android:alpha="0.9"
            android:importantForAccessibility="no"
            android:scaleType="fitCenter"
            android:src="@drawable/sprite_heron"
            app:layout_constraintBottom_toTopOf="@id/menu_hint"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/menu_eco_tile" />

        <TextView
            android:id="@+id/menu_hint"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/gap_sm"
            android:gravity="center"
            android:text="@string/menu_hint"
            android:textAppearance="@style/TextAppearance.App.Body"
            android:textSize="12sp"
            app:layout_constraintBottom_toTopOf="@id/menu_tutorial_button"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/menu_tutorial_button"
            style="@style/Widget.App.Button.Secondary"
            android:layout_width="0dp"
            android:layout_height="@dimen/btn_secondary_height"
            android:text="@string/btn_how_to_play"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
