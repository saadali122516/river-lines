<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_text_primary">

    <ImageView
        android:id="@+id/splash_background"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop"
        android:src="@drawable/bg_splash"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <View
        android:id="@+id/splash_scrim"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@drawable/overlay_splash_scrim"
        android:importantForAccessibility="no"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <View
        android:id="@+id/splash_ring_one"
        android:layout_width="@dimen/splash_ring"
        android:layout_height="@dimen/splash_ring"
        android:background="@drawable/shape_ripple_ring"
        android:importantForAccessibility="no"
        app:layout_constraintBottom_toBottomOf="@id/splash_badge"
        app:layout_constraintEnd_toEndOf="@id/splash_badge"
        app:layout_constraintStart_toStartOf="@id/splash_badge"
        app:layout_constraintTop_toTopOf="@id/splash_badge" />

    <View
        android:id="@+id/splash_ring_two"
        android:layout_width="@dimen/splash_ring"
        android:layout_height="@dimen/splash_ring"
        android:background="@drawable/shape_ripple_ring"
        android:importantForAccessibility="no"
        app:layout_constraintBottom_toBottomOf="@id/splash_badge"
        app:layout_constraintEnd_toEndOf="@id/splash_badge"
        app:layout_constraintStart_toStartOf="@id/splash_badge"
        app:layout_constraintTop_toTopOf="@id/splash_badge" />

    <View
        android:id="@+id/splash_ring_three"
        android:layout_width="@dimen/splash_ring"
        android:layout_height="@dimen/splash_ring"
        android:background="@drawable/shape_ripple_ring"
        android:importantForAccessibility="no"
        app:layout_constraintBottom_toBottomOf="@id/splash_badge"
        app:layout_constraintEnd_toEndOf="@id/splash_badge"
        app:layout_constraintStart_toStartOf="@id/splash_badge"
        app:layout_constraintTop_toTopOf="@id/splash_badge" />

    <View
        android:id="@+id/splash_badge"
        android:layout_width="@dimen/splash_badge"
        android:layout_height="@dimen/splash_badge"
        android:background="@drawable/shape_splash_badge"
        android:importantForAccessibility="no"
        app:layout_constraintBottom_toTopOf="@id/splash_title"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed"
        android:layout_marginBottom="@dimen/gap_xl" />

    <ImageView
        android:id="@+id/splash_mark"
        android:layout_width="@dimen/splash_mark"
        android:layout_height="@dimen/splash_mark"
        android:contentDescription="@string/cd_splash_mark"
        android:scaleType="fitCenter"
        android:src="@drawable/sprite_droplet"
        app:layout_constraintBottom_toBottomOf="@id/splash_badge"
        app:layout_constraintEnd_toEndOf="@id/splash_badge"
        app:layout_constraintStart_toStartOf="@id/splash_badge"
        app:layout_constraintTop_toTopOf="@id/splash_badge" />

    <TextView
        android:id="@+id/splash_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:shadowColor="#661D3557"
        android:shadowDx="0"
        android:shadowDy="3"
        android:shadowRadius="8"
        android:text="@string/title_app"
        android:textAppearance="@style/TextAppearance.App.Display"
        app:layout_constraintBottom_toTopOf="@id/splash_divider"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/splash_badge" />

    <View
        android:id="@+id/splash_divider"
        android:layout_width="@dimen/divider_width"
        android:layout_height="@dimen/divider_height"
        android:layout_marginTop="@dimen/gap_md"
        android:background="@drawable/shape_divider_accent"
        android:importantForAccessibility="no"
        app:layout_constraintBottom_toTopOf="@id/splash_subtitle"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/splash_title" />

    <TextView
        android:id="@+id/splash_subtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/gap_md"
        android:letterSpacing="0.22"
        android:text="@string/splash_subtitle"
        android:textColor="@color/color_text_on_dark"
        android:textSize="13sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/splash_divider" />

    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/splash_progress"
        style="@style/Widget.App.Progress"
        android:layout_width="@dimen/progress_width"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/gap_md"
        android:indeterminate="true"
        app:layout_constraintBottom_toTopOf="@id/splash_loading"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/splash_loading"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="64dp"
        android:letterSpacing="0.2"
        android:text="@string/splash_loading"
        android:textColor="@color/color_text_on_dark_soft"
        android:textSize="11sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
