<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/shape_note_card"
    android:gravity="center_vertical"
    android:minHeight="@dimen/touch_min"
    android:orientation="horizontal"
    android:padding="@dimen/gap_md">

    <ImageView
        android:id="@+id/challenge_status_icon"
        android:layout_width="@dimen/icon_lg"
        android:layout_height="@dimen/icon_lg"
        android:background="@drawable/shape_icon_bubble"
        android:contentDescription="@string/state_challenge_done"
        android:padding="4dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_check" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/gap_md"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/challenge_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:letterSpacing="0.05"
            android:maxLines="1"
            android:text="@string/eco_title"
            android:textColor="@color/color_text_primary"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/challenge_description"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:maxLines="2"
            android:text="@string/eco_empty"
            android:textAppearance="@style/TextAppearance.App.Body"
            android:textSize="12sp" />

    </LinearLayout>

    <TextView
        android:id="@+id/challenge_reward"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/gap_sm"
        android:fontFeatureSettings="tnum"
        android:maxLines="1"
        android:textColor="@color/color_secondary"
        android:textSize="13sp"
        android:textStyle="bold" />

</LinearLayout>
