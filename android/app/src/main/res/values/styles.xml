<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="TextAppearance.App.Display" parent="TextAppearance.Material3.DisplaySmall">
        <item name="android:textSize">38sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.14</item>
        <item name="android:textColor">@color/color_surface</item>
    </style>

    <style name="TextAppearance.App.Headline" parent="TextAppearance.Material3.HeadlineMedium">
        <item name="android:textSize">24sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.06</item>
        <item name="android:textColor">@color/color_text_primary</item>
    </style>

    <style name="TextAppearance.App.Headline.Result" parent="TextAppearance.App.Headline">
        <item name="android:textSize">30sp</item>
        <item name="android:letterSpacing">0.08</item>
    </style>

    <style name="TextAppearance.App.Title" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/color_text_primary</item>
    </style>

    <style name="TextAppearance.App.Body" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/color_text_secondary</item>
    </style>

    <style name="TextAppearance.App.Label" parent="TextAppearance.Material3.LabelSmall">
        <item name="android:textSize">11sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.18</item>
        <item name="android:textColor">@color/color_text_secondary</item>
    </style>

    <style name="TextAppearance.App.StatValue" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textSize">22sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:fontFeatureSettings">tnum</item>
    </style>

    <style name="Widget.App.Button.Primary" parent="Widget.Material3.Button">
        <item name="android:layout_height">@dimen/btn_primary_height</item>
        <item name="android:minHeight">@dimen/btn_primary_height</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.08</item>
        <item name="android:textColor">@color/color_on_primary</item>
        <item name="backgroundTint">@color/color_primary</item>
        <item name="cornerRadius">@dimen/btn_radius</item>
        <item name="android:elevation">3dp</item>
        <item name="rippleColor">#33FFFFFF</item>
        <item name="iconTint">@color/color_on_primary</item>
        <item name="iconSize">@dimen/icon_md</item>
        <item name="iconGravity">textStart</item>
        <item name="iconPadding">10dp</item>
    </style>

    <style name="Widget.App.Button.Secondary" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:layout_height">@dimen/btn_secondary_height</item>
        <item name="android:minHeight">@dimen/btn_secondary_height</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.08</item>
        <item name="android:textColor">@color/color_accent</item>
        <item name="strokeColor">@color/color_accent</item>
        <item name="strokeWidth">1.5dp</item>
        <item name="cornerRadius">@dimen/card_radius_sm</item>
        <item name="rippleColor">#1A457B9D</item>
        <item name="iconTint">@color/color_accent</item>
        <item name="iconSize">@dimen/icon_md</item>
        <item name="iconGravity">textStart</item>
    </style>

    <style name="Widget.App.Button.Icon" parent="Widget.Material3.Button.IconButton">
        <item name="android:layout_width">@dimen/btn_icon_size</item>
        <item name="android:layout_height">@dimen/btn_icon_size</item>
        <item name="android:minWidth">@dimen/touch_min</item>
        <item name="android:minHeight">@dimen/touch_min</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="backgroundTint">@color/color_surface_sunken</item>
        <item name="iconTint">@color/color_accent</item>
        <item name="iconSize">@dimen/icon_md</item>
        <item name="cornerRadius">16dp</item>
        <item name="rippleColor">#1A457B9D</item>
    </style>

    <style name="Widget.App.Card" parent="Widget.Material3.CardView.Elevated">
        <item name="cardCornerRadius">@dimen/card_radius</item>
        <item name="cardElevation">2dp</item>
        <item name="cardBackgroundColor">@color/color_surface</item>
        <item name="strokeWidth">1dp</item>
        <item name="strokeColor">@color/color_stroke_soft</item>
    </style>

    <style name="Widget.App.Card.Tile" parent="Widget.App.Card">
        <item name="cardCornerRadius">@dimen/card_radius_lg</item>
        <item name="cardElevation">3dp</item>
    </style>

    <style name="Widget.App.Progress" parent="Widget.Material3.LinearProgressIndicator">
        <item name="trackThickness">4dp</item>
        <item name="trackCornerRadius">2dp</item>
        <item name="indicatorColor">@color/color_secondary</item>
        <item name="trackColor">@color/color_track_light</item>
    </style>
</resources>
