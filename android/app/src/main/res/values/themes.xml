<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.RiverLines" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/color_primary</item>
        <item name="colorOnPrimary">@color/color_on_primary</item>
        <item name="colorPrimaryContainer">@color/color_surface_muted</item>
        <item name="colorOnPrimaryContainer">@color/color_text_primary</item>
        <item name="colorSecondary">@color/color_accent</item>
        <item name="colorOnSecondary">@color/color_on_primary</item>
        <item name="colorTertiary">@color/color_secondary</item>
        <item name="colorOnTertiary">@color/color_text_primary</item>
        <item name="colorSurface">@color/color_surface</item>
        <item name="colorOnSurface">@color/color_text_primary</item>
        <item name="colorSurfaceVariant">@color/color_surface_sunken</item>
        <item name="colorOnSurfaceVariant">@color/color_text_secondary</item>
        <item name="colorOutline">@color/color_text_tertiary</item>
        <item name="colorError">@color/color_danger</item>
        <item name="android:colorBackground">@color/color_bg</item>
        <item name="android:windowBackground">@drawable/bg_window_gradient</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:textColorPrimary">@color/color_text_primary</item>
        <item name="android:textColorSecondary">@color/color_text_secondary</item>
    </style>

    <style name="ThemeOverlay.RiverLines.Dialog" parent="ThemeOverlay.Material3.Dialog">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="colorPrimary">@color/color_primary</item>
        <item name="colorSurface">@color/color_surface</item>
        <item name="colorOnSurface">@color/color_text_primary</item>
    </style>
</resources>
